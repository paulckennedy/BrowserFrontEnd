# Environment Configuration for MarkdownEditor
# Copy this file to .env and update the values

# Application Settings
NODE_ENV=production
PORT=3000
APP_NAME=MarkdownEditor
APP_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://markdown_user:markdown_pass@postgres:5432/markdown_editor
DB_HOST=postgres
DB_PORT=5432
DB_NAME=markdown_editor
DB_USER=markdown_user
DB_PASSWORD=markdown_pass
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://:redis_password_change_in_production@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_in_production
REDIS_DB=0

# Session Configuration
SESSION_SECRET=change_this_secret_key_in_production_very_long_and_random
SESSION_COOKIE_MAX_AGE=86400000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true

# Security Settings
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
JWT_SECRET=another_very_long_random_secret_for_jwt_tokens
JWT_EXPIRATION=24h

# File Upload Settings
MAX_FILE_SIZE=50mb
UPLOAD_PATH=/app/data/uploads

# AI Integration Settings
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-3.5-turbo
AI_MAX_TOKENS=2048

# Logging Settings
LOG_LEVEL=info
LOG_FILE=/var/log/app/markdown-editor.log

# Backup Settings
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# Monitoring Settings
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=true
METRICS_PORT=9090

# SSL/TLS Settings (for production)
SSL_ENABLED=false
SSL_KEY_PATH=/etc/ssl/private/key.pem
SSL_CERT_PATH=/etc/ssl/certs/cert.pem

# External Services
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@markdowneditor.local

# Development Settings
DEV_MODE=false
DEBUG=false
HOT_RELOAD=false