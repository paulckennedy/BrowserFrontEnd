{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://browserfrontend.com/schemas/ai-agent-communication.json",
  "title": "AI Agent Communication Protocol",
  "description": "JSON schema defining the communication protocol between the frontend WYSIWYG editor and backend AI agents",
  "version": "1.0.0",
  "type": "object",
  "definitions": {
    "requestMessage": {
      "type": "object",
      "required": ["id", "type", "timestamp", "payload"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the request",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "text_analysis",
            "content_generation",
            "grammar_check",
            "style_suggestion",
            "translation",
            "summarization",
            "format_conversion"
          ],
          "description": "Type of AI operation requested"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of the request"
        },
        "payload": {
          "type": "object",
          "description": "Request-specific data",
          "properties": {
            "content": {
              "type": "string",
              "description": "Text content to be processed"
            },
            "context": {
              "type": "object",
              "properties": {
                "selection": {
                  "type": "object",
                  "properties": {
                    "start": {"type": "integer"},
                    "end": {"type": "integer"}
                  }
                },
                "documentType": {
                  "type": "string",
                  "enum": ["markdown", "html", "plain_text"]
                },
                "language": {
                  "type": "string",
                  "description": "Language code (ISO 639-1)"
                }
              }
            },
            "options": {
              "type": "object",
              "description": "Operation-specific options"
            }
          },
          "required": ["content"]
        }
      }
    },
    "responseMessage": {
      "type": "object",
      "required": ["id", "status", "timestamp"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Matches the request ID"
        },
        "status": {
          "type": "string",
          "enum": ["success", "error", "processing"],
          "description": "Response status"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of the response"
        },
        "result": {
          "type": "object",
          "description": "Success response data",
          "properties": {
            "processedContent": {
              "type": "string",
              "description": "AI-processed content"
            },
            "suggestions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["replacement", "insertion", "deletion", "formatting"]
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "start": {"type": "integer"},
                      "end": {"type": "integer"}
                    }
                  },
                  "original": {"type": "string"},
                  "suggested": {"type": "string"},
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "reason": {"type": "string"}
                }
              }
            },
            "metadata": {
              "type": "object",
              "properties": {
                "processingTime": {"type": "number"},
                "model": {"type": "string"},
                "confidence": {"type": "number"}
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error response data",
          "properties": {
            "code": {
              "type": "string",
              "enum": ["invalid_input", "processing_error", "rate_limit", "authentication_error"]
            },
            "message": {"type": "string"},
            "details": {"type": "object"}
          }
        }
      }
    },
    "streamMessage": {
      "type": "object",
      "required": ["id", "type", "chunk"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Matches the request ID"
        },
        "type": {
          "type": "string",
          "enum": ["chunk", "complete", "error"],
          "description": "Stream message type"
        },
        "chunk": {
          "type": "object",
          "properties": {
            "content": {"type": "string"},
            "position": {"type": "integer"},
            "isComplete": {"type": "boolean"}
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "Request Message",
      "$ref": "#/definitions/requestMessage"
    },
    {
      "title": "Response Message", 
      "$ref": "#/definitions/responseMessage"
    },
    {
      "title": "Stream Message",
      "$ref": "#/definitions/streamMessage"
    }
  ]
}